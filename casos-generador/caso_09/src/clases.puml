package java.time {
    class OffsetDateTime <<external>> {
    }
}

package org.evilmind.advanced {
    class Case09Application {
    +  {static} main(args : String[]) : void
    }
    class TaxAssessmentManager {
    -  {readOnly} managerId : Long
    -  {readOnly} authorityName : String
    -  {readOnly} auditTimestamp : OffsetDateTime
    -  {readOnly} jurisdictionTier : Short
    +  TaxAssessmentManager(managerId : Long, authorityName : String, auditTimestamp : OffsetDateTime, jurisdictionTier : Short) : void <<Create>>
