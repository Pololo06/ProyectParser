    }
}

package org.evilmind.advanced.TaxAssessmentManager {
    class TaxPayerRecord <<Record>> {
    +  {readOnly} taxpayerId : Long
    +  {readOnly} taxCode : String
    +  {readOnly} declaredRevenue : BigDecimal
    +  {readOnly} declaredAt : OffsetDateTime
    +  {readOnly} complianceStatus : Short
    +  {static, readOnly} REVENUE_LIMIT : BigDecimal = new BigDecimal("10000000.00")
    +  isCorporate() : Boolean
    }
    interface TaxRuleContract <<Interface>> {
    +  {abstract} evaluate(payer : TaxPayerRecord) : BigDecimal
    +  {abstract} getRulePriority() : Short
    }
    enum RateStrategy {
    +  {static, readOnly} STANDARD : RateStrategy
    +  {static, readOnly} REDUCED : RateStrategy
    +  {static, readOnly} EXEMPT : RateStrategy
    -  {readOnly} rulePriority : Short
    -  {readOnly} baseRate : BigDecimal
    ~  RateStrategy(rulePriority : Short, baseRate : BigDecimal) : void <<Create>>
    +  getBaseRate() : BigDecimal
    +  getRulePriority() : Short
    }
}

package java.math {
    class BigDecimal <<external>> {
    }
}

